author = {Lifan Liang  and Siwei Zhang  and Zicheng Wang  and Hanwen Zhang  and Chuxuan Li  and Christina Thapa  and Emily K. Oh  and David Sirkin  and Xiaotong Sun  and Alexandra Barishman  and Ada McCarroll  and Alexandra C. Duhe  and Sheng Qian  and Xiaoyuan Zhong  and Brendan Jamison  and Whitney Wood  and Alena Kozlova  and Zhiping P. Pang  and Alan R. Sanders  and Xin He  and Jubao Duan },
title = {Single-cell multiomics of neuron activation reveals context-specific genetics of brain disorders},
journal = {Science},
